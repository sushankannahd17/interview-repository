# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Local Docker:  amqp://guest:guest@localhost:5672/
# CloudAMQP:     amqps://user:pass@host/vhost
AMQP_URL=amqp://guest:guest@localhost:5672/

# ── Google Gemini ─────────────────────────────────────────────────────────────
# https://aistudio.google.com → Get API key
LLM_API_KEY=your-gemini-api-key

# ── Security ──────────────────────────────────────────────────────────────────
# Set a fresh random value; required for protected internal endpoints.
# Generate one with: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-a-random-secret

# Browser origins allowed to call the standalone AI API (comma-separated).
# The integrated platform calls this service server-to-server; set production
# browser origins explicitly if you expose this API outside Docker.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# ── Optional feature flags ────────────────────────────────────────────────────
# WEB_SEARCH_ENABLED=false
# VECTOR_SEARCH_ENABLED=false
# LLM_MODEL=gemini-2.5-flash
# DRY_RUN=false
